# Credentials for E2E runs. THIS FILE IS GITIGNORED — keep it that way.
# e2e.config.yml references these by NAME. Never paste a value into that file.

# Application login used by tests/seed.spec.ts
E2E_USER=CHANGE_ME
E2E_PASSWORD=CHANGE_ME

# Optional: a second account for role-based scenarios
E2E_ADMIN_USER=
E2E_ADMIN_PASSWORD=

# Base URL override (otherwise app.url from e2e.config.yml is used)
BASE_URL=

# API testing only
API_TOKEN=

# Jira is accessed through the Atlassian MCP connector in Claude Code.
# You should not need a token here. If your setup requires one, put it in your
# shell environment rather than this file.

# Optional third grounding source (e2e-intake step 4a) — org-wide retrieval,
# separate from this repo's own knowledge/project/. Leave all three blank to
# skip it entirely; it is additive, never required.
KNOWLEDGE_ASSISTANT_URL=
KNOWLEDGE_ASSISTANT_API_KEY=
KNOWLEDGE_ASSISTANT_PROJECT_ID=

# Optional: push results to the Workbench the moment e2e-bolt presents Gate
# 2 (ERK-1) — connected-ai-dlc-tlc's POST /api/bolts/ingest. Leave either of
# these blank to skip pushing entirely; it never blocks a bolt at Gate 2.
# No release id here on purpose - the Workbench resolves the current (or
# soonest upcoming) release for this key's project itself, at push time.
WORKBENCH_URL=
WORKBENCH_BOLT_INGEST_KEY=
