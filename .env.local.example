# Credentials for E2E runs. THIS FILE IS GITIGNORED — keep it that way.
# e2e.config.yml references these by NAME. Never paste a value into that file.

# Application login used by tests/seed.spec.ts
E2E_USER=CHANGE_ME
E2E_PASSWORD=CHANGE_ME

# Optional: a second account for role-based scenarios
E2E_ADMIN_USER=
E2E_ADMIN_PASSWORD=

# Base URL override (otherwise app.url from e2e.config.yml is used)
BASE_URL=

# API testing only
API_TOKEN=

# Jira is accessed through the Atlassian MCP connector in Claude Code.
# You should not need a token here. If your setup requires one, put it in your
# shell environment rather than this file.
